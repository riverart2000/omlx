<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joebains.omlx-orchestrator</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/joebains/omlx-orchestrator/orchestrator_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/joebains/omlx-orchestrator</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ORCH_HOST</key>
        <string>127.0.0.1</string>
        <key>ORCH_PORT</key>
        <string>8700</string>
        <key>ORCH_MODEL</key>
        <string>/Users/joebains/.omlx/models/mlx-community/Orchestrator-8B-6bit</string>
        <key>TTS_URL</key>
        <string>http://127.0.0.1:8200</string>
        <key>MEMORY_URL</key>
        <string>http://127.0.0.1:8300</string>
        <key>IMAGE_URL</key>
        <string>http://127.0.0.1:8400</string>
        <key>VIDEO_URL</key>
        <string>http://127.0.0.1:8500</string>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/joebains/omlx-orchestrator/service.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/joebains/omlx-orchestrator/service.log</string>
</dict>
</plist>
